{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md"],
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "allow",
      "npm run check": "allow",
      "npm run build": "allow",
      "npm run dev": "allow",
      "npx tsc --noEmit": "allow",
      "npx eslint *": "allow",
      "npx depcruise *": "allow",
      "node scripts/*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout *": "allow",
      "git pull*": "allow",
      "git push": "allow",
      "git push *": "allow",
      "git push --force*": "deny",
      "git push * --force*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      ".env*": "deny"
    },
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "allow",
      ".env*": "deny"
    }
  }
}
